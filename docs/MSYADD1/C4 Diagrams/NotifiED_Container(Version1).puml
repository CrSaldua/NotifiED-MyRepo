@startuml Container_StudentMobileApp

title Container Diagram - Student Mobile Application (Level 2)

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam roundcorner 10
skinparam shadowing false

skinparam rectangle {
    BorderColor #666666
    FontColor #FFFFFF
    FontSize 13
}

skinparam arrow {
    Color #666666
    FontColor #333333
    FontSize 11
}

' ===== Person =====
rectangle "**Student**\n<size:10>A university student who wants to access\nannouncements, email, calendar, and\nnotifications from a single application.</size>" as student #08427B

' ===== System Boundary =====
package "Student Mobile Application (React Native)" {

    rectangle "**UI / Presentation Layer**\n<size:10>Screens for Dashboard, Announcements,\nEmail, Calendar, Notifications, and\nSign In. Renders data and captures\nstudent interactions.</size>" as uiLayer #1168BD

    rectangle "**AI Chatbot Module**\n<size:10>Interprets natural language requests.\nSummarizes announcements, emails, and\ncalendar events. Handles in-app\nnavigation commands.</size>" as chatbot #1168BD

    rectangle "**Auth Handler**\n<size:10>Manages the OAuth 2.0 sign-in flow.\nRedirects to Microsoft Identity Platform\nand stores/refreshes authorization\ntokens securely on-device.</size>" as authHandler #1168BD

    rectangle "**API Client**\n<size:10>Sends REST requests to the backend.\nAttaches auth tokens to requests.\nHandles responses and errors.</size>" as apiClient #1168BD

    rectangle "**Local State / Cache**\n<size:10>Stores app state (e.g. Redux/Context).\nCaches recently fetched data for\nfaster loading and offline viewing.</size>" as localState #1168BD

}

' ===== External Systems =====
rectangle "**Backend Integration Service**\n<size:10>Retrieves, aggregates, and exposes public\nand personalized information through\nstandardized REST APIs.\n(Developed by Team 1)</size>" as backendService #999999

rectangle "**Microsoft Identity Platform**\n<size:10>Authenticates students using their\nuniversity Microsoft account and\nissues authorization tokens.</size>" as msIdentity #999999

' ===== Relationships =====
student -down-> uiLayer : "Views screens,\nsigns in, interacts\nwith chatbot"

uiLayer -down-> authHandler : "Initiates sign-in"
uiLayer -down-> apiClient : "Requests announcements,\nemail, calendar,\nnotifications"
uiLayer -right-> chatbot : "Sends chat messages\n/ commands"

chatbot -down-> apiClient : "Requests data\nto summarize"
chatbot -up-> uiLayer : "Triggers navigation\nto requested screen"

apiClient -down-> localState : "Reads / writes\ncached data"

authHandler -right-> msIdentity : "Authenticates student\n<size:9>[OAuth 2.0 / HTTPS]</size>"
authHandler -down-> apiClient : "Provides access token"

apiClient -down-> backendService : "Requests data\n<size:9>[REST API / HTTPS]</size>"

' ===== Legend =====
legend right
  |= Color |= Type |
  |<#08427B>| Person |
  |<#1168BD>| Container (In Scope) |
  |<#999999>| External System |
endlegend

@enduml